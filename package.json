{
    "name": "tetloose-fractal",
    "version": "1.0.0",
    "description": "",
    "main": "./gulpfile.babel.js",
    "keywords": [
        "Fractal",
        "Webpack",
        "Gulp",
        "Yarn",
        "Typescript",
        "CSS Modules",
        "SCSS",
        "WCAG AAA",
        "Speed Performance"
    ],
    "author": "James Tetley tetloose.com",
    "license": "ISC",
    "babel": {
        "presets": [
            "@babel/preset-env"
        ]
    },
    "private": true,
    "scripts": {
        "setup": "./toolkit setup",
        "dev": "gulp clean; ENV=dev gulp; ENV=dev gulp fractalServe",
        "build": "gulp clean; gulp build; gulp fractalBuild",
        "favicon": "gulp cleanFavicon; gulp favicon",
        "git:commit": "./toolkit git-commit",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint --ext .js,.ts .",
        "pre-commit": "yarn lint && vitest --watch false",
        "create-hook": "husky add .husky/pre-commit \"yarn pre-commit\"",
        "prepare": "husky install",
        "gen:component": "./toolkit generate-component"
    },
    "dependencies": {
        "@frctl/fractal": "^1.5.15",
        "@frctl/nunjucks": "^2.0.15",
        "gulp-shell": "^0.8.0"
    },
