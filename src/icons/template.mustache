@include font-face('icons', '../icons/icons', normal, svg woff ttf);

%icons {
	display: inline-block;
	font-style: normal;
	font-family: icons, sans-serif;
	line-height: 1;
	text-rendering: auto;

	@include font-smoothing;
}

[class*=u-icon-] {
    @extend %icons;
}
{{#icons}}

.u-icon-{{name}}::before {
	content: '\{{code}}';
}
{{/icons}}
